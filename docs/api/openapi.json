                          "owner",
                          "commercial",
                          "tech",
                          "member"
                        ]
                      }
                    },
                    "permissions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "admin.access",
                          "content.manage",
                          "events.manage",
                          "prices.manage",
                          "access.grant",
                          "roles.manage",
                          "finance.read",
                          "refunds.manage",
                          "tickets.support",
                          "checkin.perform",
                          "tech.config"
                        ]
                      }
                    }
                  },
                  "required": [
                    "userId",
                    "roles",
                    "permissions"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Sem sessão válida"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
