NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Server-only. Ambiente lógico (CF-012): development | staging | production.
APP_ENV=development

# Supabase do PRÓPRIO ambiente: só URL e chave pública (anon/publishable), protegidas por RLS.
# Opcionais até a hospedagem ser escolhida (P-014). service_role NUNCA entra no web.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Ref público do projeto de produção, para o /status acusar staging apontando para ele.
SUPABASE_PRODUCTION_REF=

# Server-only. Módulos não lançados (CF-158), mesmo valor da API: vazio = padrão do ambiente.
# Ex.: `community,events` liga, `-planning` desliga. Nunca usar NEXT_PUBLIC_ para flags.
FEATURE_FLAGS=

# Server-only. Habilita as rotas internas /prototipo, /design e /status (CF-169/CF-170) em
# staging/preview. Em dev já vêm ligadas; em produção ficam bloqueadas sem esta variável.
# ENABLE_PREVIEW_ROUTES=true
