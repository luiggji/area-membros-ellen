{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/me": {
      "get": {
        "operationId": "MeController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "userId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "roles": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "owner",
                          "commercial",
                          "tech",
                          "member"
                        ]
                      }
                    },
                    "permissions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "admin.access",
                          "content.manage",
                          "events.manage",
                          "prices.manage",
                          "roles.manage",
                          "finance.read",
                          "refunds.manage",
                          "tickets.support",
                          "checkin.perform",
                          "tech.config"
                        ]
                      }
                    }
                  },
                  "required": [
                    "userId",
                    "roles",
                    "permissions"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Sem sessão válida"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Papéis e permissões de quem está logado (sem PII)",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_handle",
        "parameters": [],
        "responses": {
          "200": {
            "description": "API no ar",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "service": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    "checks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "healthy": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "name",
                          "healthy"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "status",
                    "service",
                    "version",
                    "timestamp",
                    "checks"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "429": {
            "description": "Rate limit por IP excedido (CF-152)"
          }
        },
        "summary": "Saúde da API (sem PII nem segredos)",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Caixa Forte API",
    "description": "API da área de membros Caixa Forte. Contratos em @caixa-forte/contracts (zod); autorização sempre no servidor.",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {}
  }
}
