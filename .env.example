# Copie para .env.local (web) / .env (api). NUNCA commitar valores reais.
# Cada ambiente (local, preview, staging, production) tem chaves PRÓPRIAS.

# ---- Web (apps/web) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
