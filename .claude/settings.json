{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(pnpm check*)",
      "Bash(pnpm format*)",
      "Bash(pnpm branch:check*)",
      "Bash(pnpm --filter *)",
      "Bash(pnpm install --frozen-lockfile*)",
      "Bash(pnpm audit*)",
      "Bash(node .github/scripts/check-branch-name.mjs*)",
      "Bash(node .github/scripts/bootstrap-github.mjs plan*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git fetch*)",
      "Bash(git pull --ff-only*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr list*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr comment*)",
      "Bash(gh issue create*)",
      "Bash(gh issue edit*)",
      "Bash(gh api*)",
      "Bash(pnpm add*)",
      "Bash(npx supabase*)",
      "Bash(pnpm dlx supabase*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin develop*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(npx supabase db reset --linked*)",
      "Bash(npx supabase db push*)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.production)",
      "Read(./**/.env.staging)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)"
    ]
  }
}
