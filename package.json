{
  "name": "caixa-forte",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "branch:check": "node .github/scripts/check-branch-name.mjs",
    "db:types": "npx -y supabase@2.120.0 gen types typescript --local --schema public > packages/contracts/src/database.types.ts"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3"
  }
}
