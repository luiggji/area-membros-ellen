API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000
# Rate limit por IP (CF-152) e proxies confiáveis na frente da API (0 em dev; o host define, CF-015).
API_RATE_LIMIT_PER_MINUTE=120
API_TRUST_PROXY=0
# Swagger UI (/api/v1/docs) e /api/v1/openapi.json (CF-151). Vazio: ligado fora de produção.
API_DOCS_ENABLED=

# Módulos não lançados (CF-158): vazio = padrão do ambiente (dev liga tudo; staging/produção
# desligam). Lista com vírgula: `community,events` liga, `-planning` desliga.
FEATURE_FLAGS=

# Revalidação das páginas públicas do web quando preço/evento/catálogo muda (CF-163). Os dois
# juntos; segredo com 32+ caracteres, o mesmo REVALIDATE_SECRET do web.
WEB_REVALIDATE_URL=
REVALIDATE_SECRET=

# Links de vídeo do player (CF-083): segredo com 32+ caracteres para assinar os tokens de mídia.
# Vazio em dev = cada processo sorteia o seu. O provedor de vídeo ainda será escolhido (P-007).
MEDIA_SIGNING_SECRET=

# Ambiente lógico (CF-012): development | staging | production. Cada um tem banco, storage,
# gateway e chaves próprios — ver docs/runbooks/ambientes.md.
APP_ENV=development

# Supabase do PRÓPRIO ambiente. Opcional em development até a hospedagem ser escolhida (P-014).
# Local (Docker): http://127.0.0.1:54321 e a service_role impressa por `npx supabase start`.
SUPABASE_URL=
# Segredo: só aqui na API. Nunca em NEXT_PUBLIC_*, nunca no repositório.
SUPABASE_SERVICE_ROLE_KEY=
# Ref PÚBLICO do projeto de produção (https://<ref>.supabase.co). A API recusa subir em
# dev/staging apontando para ele.
SUPABASE_PRODUCTION_REF=

# Só dev/staging: senha das pessoas de teste criadas por `pnpm seed:dev` (CF-154). 10+ caracteres
# com maiúscula, minúscula e dígito. O script se recusa a rodar em produção.
SEED_USER_PASSWORD=
